# ==============================================================================
# DayTrace Environment Configuration Template
# For Netlify Deployment: Add these variables in Site Configuration > Environment Variables
# NEVER commit actual secrets or API keys to this file or source control.
# ==============================================================================

# 1. Google Gemini API Key (Required for server-side AI Mentor and Weekly Reviews)
GEMINI_API_KEY=

# 2. JWT Secret (Required for secure user authentication and session tokens)
JWT_SECRET=

# 3. Persistent Database Connection URL (PostgreSQL)
# Required for persistent authentication across serverless restarts and Netlify deployments.
# Use a PostgreSQL database URI from Neon, Supabase, Railway, Tembo, or any PostgreSQL provider.
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=

# 4. Node Environment (Set to "production" in Netlify)
NODE_ENV=production
